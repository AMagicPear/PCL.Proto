{
  "type": "PPageRight",
  "attrs": {
    "Class": "PCL.PageDownloadClient",
    "PanScroll": "{Binding ElementName=PanBack}"
  },
  "children": [
    {
      "type": "Grid",
      "attrs": {},
      "children": [
        {
          "type": "PScrollViewer",
          "attrs": {
            "VerticalScrollBarVisibility": "Auto",
            "HorizontalScrollBarVisibility": "Disabled",
            "Name": "PanBack"
          },
          "children": [
            {
              "type": "StackPanel",
              "attrs": {
                "Orientation": "Vertical",
                "Margin": "5"
              },
              "children": [
                {
                  "type": "StackPanel",
                  "attrs": {
                    "Name": "PanMain",
                    "Margin": "20,20,20,5",
                    "Grid.IsSharedSizeScope": "True"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "PCard",
          "attrs": {
            "HorizontalAlignment": "Center",
            "VerticalAlignment": "Center",
            "Margin": "40,0",
            "SnapsToDevicePixels": "True",
            "Name": "PanLoad",
            "UseAnimation": "False"
          },
          "children": [
            {
              "type": "PLoading",
              "attrs": {
                "Text": "{DynamicResource Download.Version.LoadingList}",
                "Margin": "20,20,20,17",
                "Name": "Load",
                "HorizontalAlignment": "Center",
                "VerticalAlignment": "Center"
              }
            }
          ]
        }
      ]
    }
  ]
}
