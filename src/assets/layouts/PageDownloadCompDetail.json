{
  "type": "PPageRight",
  "attrs": {
    "Class": "PCL.PageDownloadCompDetail",
    "PanScroll": "{Binding ElementName=PanBack}"
  },
  "children": [
    {
      "type": "PScrollViewer",
      "attrs": {
        "VerticalScrollBarVisibility": "Auto",
        "HorizontalScrollBarVisibility": "Disabled",
        "Name": "PanBack"
      },
      "children": [
        {
          "type": "Grid",
          "attrs": {
            "Margin": "25,25,25,10"
          },
          "children": [
            {
              "type": "Grid.RowDefinitions",
              "attrs": {},
              "children": [
                {
                  "type": "RowDefinition",
                  "attrs": {
                    "Height": "Auto"
                  }
                },
                {
                  "type": "RowDefinition",
                  "attrs": {
                    "Height": "1*"
                  }
                }
              ]
            },
            {
              "type": "PCard",
              "attrs": {
                "Margin": "0,0,0,25",
                "Name": "CardIntro"
              },
              "children": [
                {
                  "type": "StackPanel",
                  "attrs": {
                    "Margin": "22,20,2,20",
                    "Name": "PanIntro"
                  },
                  "children": [
                    {
                      "type": "StackPanel",
                      "attrs": {
                        "Orientation": "Horizontal",
                        "HorizontalAlignment": "Left"
                      },
                      "children": [
                        {
                          "type": "PIconTextButton",
                          "attrs": {
                            "Name": "BtnIntroWeb",
                            "Text": "CurseForge",
                            "BorderBrush": "{DynamicResource ColorBrush6}",
                            "BorderThickness": "1",
                            "SvgIcon": "lucide/globe",
                            "Margin": "0,0,3,0",
                            "HorizontalAlignment": "Left"
                          }
                        },
                        {
                          "type": "PIconTextButton",
                          "attrs": {
                            "Name": "BtnIntroWiki",
                            "Text": "{DynamicResource Download.Comp.Detail.McMod}",
                            "BorderBrush": "{DynamicResource ColorBrush6}",
                            "BorderThickness": "1",
                            "SvgIcon": "lucide/globe",
                            "Margin": "0,0,3,0",
                            "HorizontalAlignment": "Left"
                          }
                        },
                        {
                          "type": "PIconTextButton",
                          "attrs": {
                            "Name": "BtnIntroCopy",
                            "Text": "{DynamicResource Download.Comp.Detail.CopyName}",
                            "BorderBrush": "{DynamicResource ColorBrush6}",
                            "BorderThickness": "1",
                            "SvgIcon": "lucide/copy",
                            "Margin": "0,0,3,0",
                            "HorizontalAlignment": "Left"
                          }
                        },
                        {
                          "type": "PIconTextButton",
                          "attrs": {
                            "Name": "BtnIntroLinkCopy",
                            "Text": "{DynamicResource Download.Comp.Detail.CopyLink}",
                            "BorderBrush": "{DynamicResource ColorBrush6}",
                            "BorderThickness": "1",
                            "SvgIcon": "lucide/copy",
                            "Margin": "0,0,3,0",
                            "HorizontalAlignment": "Left"
                          }
                        },
                        {
                          "type": "PIconTextButton",
                          "attrs": {
                            "Name": "BtnTranslate",
                            "Text": "{DynamicResource Download.Comp.Detail.TranslateDescription}",
                            "BorderBrush": "{DynamicResource ColorBrush6}",
                            "BorderThickness": "1",
                            "SvgIcon": "lucide/earth",
                            "Margin": "0,0,3,0",
                            "HorizontalAlignment": "Left"
                          }
                        },
                        {
                          "type": "PIconTextButton",
                          "attrs": {
                            "Name": "BtnFavorites",
                            "Text": "{DynamicResource Download.Comp.Detail.Favorite}",
                            "BorderBrush": "{DynamicResource ColorBrush6}",
                            "BorderThickness": "1",
                            "SvgIcon": "lucide/heart",
                            "Margin": "0,0,2,0",
                            "HorizontalAlignment": "Left"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "StackPanel",
              "attrs": {
                "Grid.Row": "1",
                "Grid.RowSpan": "2",
                "Name": "PanMain",
                "Grid.IsSharedSizeScope": "True"
              },
              "children": [
                {
                  "type": "PCard",
                  "attrs": {
                    "Margin": "0,0,0,15",
                    "Name": "CardFilter"
                  },
                  "children": [
                    {
                      "type": "StackPanel",
                      "attrs": {},
                      "children": [
                        {
                          "type": "StackPanel",
                          "attrs": {
                            "Name": "PanInstanceFilter",
                            "Margin": "10,10,0,5",
                            "Orientation": "Horizontal",
                            "VerticalAlignment": "Top",
                            "HorizontalAlignment": "Left"
                          }
                        },
                        {
                          "type": "StackPanel",
                          "attrs": {
                            "Name": "PanModLoaderFilter",
                            "Margin": "10,5,0,10",
                            "Orientation": "Horizontal",
                            "VerticalAlignment": "Top",
                            "HorizontalAlignment": "Left"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "StackPanel",
                  "attrs": {
                    "Name": "PanResults"
                  }
                }
              ]
            },
            {
              "type": "PCard",
              "attrs": {
                "Grid.Row": "1",
                "HorizontalAlignment": "Center",
                "VerticalAlignment": "Center",
                "SnapsToDevicePixels": "True",
                "Name": "PanLoad",
                "UseAnimation": "False",
                "Margin": "0,0,0,8"
              },
              "children": [
                {
                  "type": "PLoading",
                  "attrs": {
                    "Text": "{DynamicResource Download.Version.LoadingList}",
                    "Margin": "20,20,20,17",
                    "Name": "Load",
                    "HorizontalAlignment": "Center",
                    "VerticalAlignment": "Center"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
