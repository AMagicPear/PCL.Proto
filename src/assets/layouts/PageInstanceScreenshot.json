{
  "type": "PPageRight",
  "attrs": {
    "Class": "PCL.PageInstanceScreenshot",
    "PanScroll": "{Binding ElementName=PanBack}",
    "Grid.IsSharedSizeScope": "True"
  },
  "children": [
    {
      "type": "PScrollViewer",
      "attrs": {
        "VerticalScrollBarVisibility": "Auto",
        "HorizontalScrollBarVisibility": "Disabled",
        "Name": "PanBack"
      },
      "children": [
        {
          "type": "Grid",
          "attrs": {},
          "children": [
            {
              "type": "PCard",
              "attrs": {
                "HorizontalAlignment": "Center",
                "VerticalAlignment": "Center",
                "Margin": "40",
                "Name": "PanNoPic"
              },
              "children": [
                {
                  "type": "Grid",
                  "attrs": {
                    "Margin": "20,17"
                  },
                  "children": [
                    {
                      "type": "Grid.RowDefinitions",
                      "attrs": {},
                      "children": [
                        {
                          "type": "RowDefinition",
                          "attrs": {
                            "Height": "Auto"
                          }
                        },
                        {
                          "type": "RowDefinition",
                          "attrs": {
                            "Height": "Auto"
                          }
                        },
                        {
                          "type": "RowDefinition",
                          "attrs": {
                            "Height": "Auto"
                          }
                        },
                        {
                          "type": "RowDefinition",
                          "attrs": {
                            "Height": "Auto"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Grid.ColumnDefinitions",
                      "attrs": {},
                      "children": [
                        {
                          "type": "ColumnDefinition",
                          "attrs": {
                            "Width": "1*"
                          }
                        },
                        {
                          "type": "ColumnDefinition",
                          "attrs": {
                            "Width": "Auto"
                          }
                        },
                        {
                          "type": "ColumnDefinition",
                          "attrs": {
                            "Width": "Auto"
                          }
                        },
                        {
                          "type": "ColumnDefinition",
                          "attrs": {
                            "Width": "1*"
                          }
                        }
                      ]
                    },
                    {
                      "type": "TextBlock",
                      "attrs": {
                        "Grid.Row": "0",
                        "Grid.ColumnSpan": "4",
                        "Margin": "0,0,0,9",
                        "HorizontalAlignment": "Center",
                        "Text": "{DynamicResource Instance.Screenshot.Empty.Title}",
                        "FontSize": "19",
                        "UseLayoutRounding": "True",
                        "SnapsToDevicePixels": "True",
                        "Foreground": "{DynamicResource ColorBrush3}"
                      }
                    },
                    {
                      "type": "Rectangle",
                      "attrs": {
                        "Grid.Row": "1",
                        "Grid.ColumnSpan": "4",
                        "HorizontalAlignment": "Stretch",
                        "Height": "2",
                        "Fill": "{DynamicResource ColorBrush3}"
                      }
                    },
                    {
                      "type": "TextBlock",
                      "attrs": {
                        "Grid.Row": "2",
                        "Grid.ColumnSpan": "4",
                        "Margin": "10,15,10,5",
                        "Text": "{DynamicResource Instance.Screenshot.Empty.Message}",
                        "TextWrapping": "Wrap"
                      }
                    },
                    {
                      "type": "PButton",
                      "attrs": {
                        "Grid.Row": "3",
                        "Grid.Column": "1",
                        "Height": "35",
                        "HorizontalAlignment": "Center",
                        "Name": "BtnOpenFolderTop",
                        "MinWidth": "140",
                        "Text": "{DynamicResource Instance.Screenshot.OpenFolder}",
                        "Margin": "10,10,10,0",
                        "Padding": "13,0",
                        "ColorType": "Highlight"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "StackPanel",
              "attrs": {
                "Orientation": "Vertical",
                "Margin": "10,25,10,10",
                "Name": "PanContent"
              },
              "children": [
                {
                  "type": "PCard",
                  "attrs": {
                    "Margin": "15,0,15,15",
                    "Title": "{DynamicResource Instance.Screenshot.QuickActions}"
                  },
                  "children": [
                    {
                      "type": "Grid",
                      "attrs": {
                        "Height": "35",
                        "Margin": "25,40,15,20"
                      },
                      "children": [
                        {
                          "type": "Grid.ColumnDefinitions",
                          "attrs": {},
                          "children": [
                            {
                              "type": "ColumnDefinition",
                              "attrs": {
                                "Width": "Auto",
                                "SharedSizeGroup": "Button"
                              }
                            },
                            {
                              "type": "ColumnDefinition",
                              "attrs": {
                                "Width": "Auto",
                                "SharedSizeGroup": "Button"
                              }
                            }
                          ]
                        },
                        {
                          "type": "PButton",
                          "attrs": {
                            "Grid.Column": "0",
                            "MinWidth": "140",
                            "Text": "{DynamicResource Instance.Screenshot.OpenFolder}",
                            "Padding": "13,0",
                            "Margin": "0,0,20,0",
                            "HorizontalAlignment": "Left",
                            "Name": "BtnOpenFolder",
                            "ColorType": "Highlight"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "WrapPanel",
                  "attrs": {
                    "Margin": "8,0,8,25",
                    "Name": "PanList",
                    "HorizontalAlignment": "Center",
                    "Orientation": "Horizontal"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
