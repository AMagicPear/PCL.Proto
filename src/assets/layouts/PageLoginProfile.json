{
  "type": "Grid",
  "attrs": {
    "Class": "PCL.PageLoginProfile",
    "Tag": "False",
    "DataContext": "{Binding RelativeSource={RelativeSource Self}}"
  },
  "children": [
    {
      "type": "Grid.RowDefinitions",
      "attrs": {},
      "children": [
        {
          "type": "RowDefinition",
          "attrs": {
            "Height": "Auto"
          }
        },
        {
          "type": "RowDefinition",
          "attrs": {
            "Height": "Auto"
          }
        },
        {
          "type": "RowDefinition",
          "attrs": {
            "Height": "10"
          }
        },
        {
          "type": "RowDefinition",
          "attrs": {
            "Height": "*"
          }
        },
        {
          "type": "RowDefinition",
          "attrs": {
            "Height": "10"
          }
        },
        {
          "type": "RowDefinition",
          "attrs": {
            "Height": "Auto"
          }
        },
        {
          "type": "RowDefinition",
          "attrs": {
            "Height": "20"
          }
        }
      ]
    },
    {
      "type": "PHint",
      "attrs": {
        "Name": "HintSelect",
        "Margin": "0,10,0,0",
        "Theme": "Blue",
        "Text": "{DynamicResource Launch.Account.Profile.SelectHint}",
        "Grid.Row": "0",
        "CanClose": "True",
        "RelativeSetup": "HintProfileSelect"
      }
    },
    {
      "type": "PHint",
      "attrs": {
        "Name": "HintCreate",
        "Margin": "0,10,0,0",
        "Theme": "Blue",
        "Text": "{DynamicResource Launch.Account.Profile.CreateAndSelectHint}",
        "Grid.Row": "0",
        "Visibility": "Collapsed"
      }
    },
    {
      "type": "PHint",
      "attrs": {
        "Name": "HintMicrosoft",
        "Margin": "0,10,0,0",
        "Theme": "Yellow",
        "Text": "{DynamicResource Launch.Account.Profile.RequireMicrosoftHint}",
        "Grid.Row": "1",
        "Visibility": "Collapsed"
      }
    },
    {
      "type": "PScrollViewer",
      "attrs": {
        "Grid.Row": "3",
        "MaxHeight": "300",
        "Margin": "10,0,10,0"
      },
      "children": [
        {
          "type": "ItemsControl",
          "attrs": {
            "ItemsSource": "{Binding ProfileCollection}"
          },
          "children": [
            {
              "type": "ItemsControl.ItemTemplate",
              "attrs": {},
              "children": [
                {
                  "type": "DataTemplate",
                  "attrs": {},
                  "children": [
                    {
                      "type": "PListItem",
                      "attrs": {
                        "Margin": "8,2,10,2",
                        "Title": "{Binding Username}",
                        "Info": "{Binding Info}",
                        "Type": "Clickable",
                        "Logo": "{Binding Logo}",
                        "SvgIcon": "{Binding SvgIcon}",
                        "Tag": "{Binding Profile}",
                        "Click": "SelectProfile",
                        "ContentHandler": "ProfileContMenuBuild"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "PCard",
      "attrs": {
        "Grid.Row": "5",
        "HorizontalAlignment": "Center",
        "Name": "PanButtons",
        "Opacity": "10",
        "CornerRadius": "5",
        "Margin": "0,0,4,0"
      },
      "children": [
        {
          "type": "StackPanel",
          "attrs": {
            "Orientation": "Horizontal",
            "Margin": "10,3,0,3"
          },
          "children": [
            {
              "type": "PIconButton",
              "attrs": {
                "Height": "24",
                "Margin": "0,0.5,9,0",
                "Name": "BtnNew",
                "Click": "BtnNew_Click",
                "ToolTip": "{DynamicResource Launch.Account.Profile.Create}",
                "ToolTipService.Placement": "Center",
                "ToolTipService.VerticalOffset": "35",
                "ToolTipService.HorizontalOffset": "1",
                "ToolTipService.InitialShowDelay": "50",
                "LogoScale": "1.08",
                "SvgIcon": "lucide/user-plus"
              }
            }
          ]
        }
      ]
    }
  ]
}
