                {
                  "type": "PIconTextButton",
                  "attrs": {
                    "Name": "BtnSelectShare",
                    "Text": "{DynamicResource Instance.Resource.ShareSelected}",
                    "LogoScale": "1",
                    "SvgIcon": "lucide/share-2"
                  }
