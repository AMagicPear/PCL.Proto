{
  "type": "PPageRight",
  "attrs": {
    "Class": "PCL.PageInstanceSavesDatapack",
    "PanScroll": "{Binding ElementName=PanBack}"
  },
  "children": [
    {
      "type": "Grid",
      "attrs": {},
      "children": [
        {
          "type": "Grid",
          "attrs": {
            "Name": "PanAllBack"
          },
          "children": [
            {
              "type": "PScrollViewer",
