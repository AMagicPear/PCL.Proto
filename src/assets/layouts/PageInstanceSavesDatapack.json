                              "type": "PIconTextButton",
                              "attrs": {
                                "Name": "BtnSort",
                                "Text": "{DynamicResource Instance.Resource.Sort.Text}",
                                "SvgIcon": "lucide/arrow-up-down"
                              }
                            }
                          ]
                        },
                        {
                          "type": "StackPanel",
                          "attrs": {
                            "Margin": "20,48,18,22",
                            "Name": "PanList",
