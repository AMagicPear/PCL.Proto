                                "Margin": "2,0",
                                "Text": "{DynamicResource Instance.Resource.Filter.Disabled}",
                                "Name": "BtnFilterDisabled"
                              }
                            },
                            {
                              "type": "PRadioButton",
                              "attrs": {
                                "Tag": "3",
                                "ColorType": "Highlight",
                                "VerticalAlignment": "Center",
                                "Margin": "2,0",
                                "Text": "{DynamicResource Instance.Resource.Filter.Updatable}",
                                "Name": "BtnFilterCanUpdate"
