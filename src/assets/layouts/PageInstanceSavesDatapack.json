                            {
                              "type": "PRadioButton",
                              "attrs": {
                                "Tag": "4",
                                "ColorType": "Highlight",
                                "VerticalAlignment": "Center",
                                "Margin": "2,0",
                                "Text": "{DynamicResource Instance.Resource.Filter.Error}",
                                "Name": "BtnFilterError"
                              }
                            }
                          ]
