            {
              "type": "TextBlock",
              "attrs": {
                "Name": "LabSelect",
                "Text": "",
                "HorizontalAlignment": "Center",
                "VerticalAlignment": "Top",
                "Margin": "9",
                "Foreground": "{DynamicResource ColorBrush2}"
              }
            },
            {
              "type": "StackPanel",
              "attrs": {
                "Orientation": "Horizontal",
                "Margin": "5,28,5,5"
