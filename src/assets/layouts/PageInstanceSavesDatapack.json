          "children": [
            {
              "type": "PLoading",
              "attrs": {
                "Text": "{DynamicResource Instance.Resource.Datapack.Loading}",
                "Margin": "20,20,20,17",
                "Name": "Load",
                "HorizontalAlignment": "Center",
                "VerticalAlignment": "Center"
