                "VerticalScrollBarVisibility": "Auto",
                "HorizontalScrollBarVisibility": "Disabled",
                "Name": "PanBack"
              },
              "children": [
                {
                  "type": "StackPanel",
                  "attrs": {
                    "Name": "PanMain",
                    "Margin": "25,10,25,10",
                    "Grid.IsSharedSizeScope": "True"
