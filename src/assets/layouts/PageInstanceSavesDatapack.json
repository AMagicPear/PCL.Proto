                {
                  "type": "PIconTextButton",
                  "attrs": {
                    "Name": "BtnSelectDelete",
                    "Text": "{DynamicResource Common.Action.Delete}",
                    "LogoScale": "0.96",
                    "SvgIcon": "lucide/trash-2"
