                  "children": [
                    {
                      "type": "PSearchBox",
                      "attrs": {
                        "Margin": "0,15",
                        "HintText": "{DynamicResource Instance.Resource.Search.Hint}",
                        "Name": "SearchBox"
                      }
                    },
                    {
                      "type": "PCard",
                      "attrs": {
                        "Margin": "0,0,0,15",
