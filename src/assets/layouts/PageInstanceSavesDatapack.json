                {
                  "type": "PIconTextButton",
                  "attrs": {
                    "Name": "BtnSelectCancel",
                    "Text": "{DynamicResource Instance.Resource.CancelSelection}",
                    "LogoScale": "0.8",
                    "SvgIcon": "lucide/x"
                  }
                }
