                        {
                          "type": "PButton",
                          "attrs": {
                            "Height": "35",
                            "Name": "BtnHintInstall",
                            "MinWidth": "130",
                            "Text": "{DynamicResource Instance.Resource.InstallFromFiles}",
                            "Margin": "5,0",
                            "Padding": "12,0",
                            "ColorType": "Highlight"
                          }
                        },
                        {
                          "type": "PButton",
                          "attrs": {
                            "Height": "35",
                            "Name": "BtnHintDownload",
                            "MinWidth": "130",
                            "Text": "{DynamicResource Instance.Resource.Datapack.DownloadNew}",
                            "Margin": "5,0",
                            "Padding": "12,0"
                          }
                        },
                        {
                          "type": "PButton",
                          "attrs": {
                            "Height": "35",
                            "Name": "BtnHintOpen",
                            "MinWidth": "130",
                            "Text": "{DynamicResource Common.Action.OpenFolder}",
                            "Margin": "5,0",
                            "Padding": "12,0"
