              "children": [
                {
                  "type": "PIconTextButton",
                  "attrs": {
                    "Name": "BtnSelectUpdate",
                    "Text": "{DynamicResource Instance.Resource.Update}",
                    "LogoScale": "1",
                    "SvgIcon": "lucide/upload"
                  }
                },
                {
                  "type": "PIconTextButton",
                  "attrs": {
                    "Name": "BtnSelectEnable",
                    "Text": "{DynamicResource Instance.Resource.Enable}",
                    "LogoScale": "1.05",
                    "SvgIcon": "lucide/circle-check"
                  }
                },
                {
                  "type": "PIconTextButton",
                  "attrs": {
                    "Name": "BtnSelectDisable",
                    "Text": "{DynamicResource Instance.Resource.Disable}",
                    "LogoScale": "1",
                    "SvgIcon": "lucide/circle-minus"
                  }
                },
                {
                  "type": "PIconTextButton",
                  "attrs": {
                    "Name": "BtnSelectFavorites",
                    "Text": "{DynamicResource Instance.Resource.Favorite}",
                    "LogoScale": "1",
                    "SvgIcon": "lucide/heart"
