{
  "type": "Grid",
  "attrs": {
    "Class": "PCL.MyMsgLogin",
    "RenderTransformOrigin": "0,0.5",
    "UseLayoutRounding": "True",
    "SnapsToDevicePixels": "True",
    "MinWidth": "400",
    "HorizontalAlignment": "Center",
    "VerticalAlignment": "Center",
    "Margin": "25"
  },
  "children": [
    {
      "type": "Grid.RenderTransform",
      "attrs": {},
      "children": [
        {
          "type": "TransformGroup",
          "attrs": {},
          "children": [
            {
              "type": "RotateTransform",
              "attrs": {
                "Name": "TransformRotate",
                "Angle": "-4"
              }
            },
            {
              "type": "TranslateTransform",
              "attrs": {
                "Name": "TransformPos",
                "X": "0",
                "Y": "40"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "BlurBorder",
      "attrs": {
        "Name": "PanBorder",
        "CornerRadius": "7",
        "Background": "{DynamicResource ColorBrushBackground}",
        "MouseLeftButtonDown": "Drag"
      },
      "children": [
        {
          "type": "BlurBorder.Effect",
          "attrs": {},
          "children": [
            {
              "type": "DropShadowEffect",
              "attrs": {
                "Color": "{DynamicResource ColorObjectMsgBoxShadow}",
                "BlurRadius": "20",
                "ShadowDepth": "4",
                "RenderingBias": "Performance",
                "Opacity": "0.8",
                "Name": "EffectShadow"
              }
            }
          ]
        },
        {
          "type": "Grid",
          "attrs": {
            "Name": "PanMain",
            "VerticalAlignment": "Top",
            "Margin": "22,22,22,23"
          },
          "children": [
            {
              "type": "Grid.RowDefinitions",
              "attrs": {},
              "children": [
                {
                  "type": "RowDefinition",
                  "attrs": {
                    "Height": "Auto"
                  }
                },
                {
                  "type": "RowDefinition",
                  "attrs": {
                    "Height": "2"
                  }
                },
                {
                  "type": "RowDefinition",
                  "attrs": {
                    "Height": "13"
                  }
                },
                {
                  "type": "RowDefinition",
                  "attrs": {
                    "Height": "1*"
                  }
                },
                {
                  "type": "RowDefinition",
                  "attrs": {
                    "Height": "Auto"
                  }
                }
              ]
            },
            {
              "type": "TextBlock",
              "attrs": {
                "Grid.Row": "0",
                "FontSize": "23",
                "TextTrimming": "None",
                "Foreground": "{DynamicResource ColorBrush2}",
                "HorizontalAlignment": "Left",
                "Name": "LabTitle",
                "Margin": "7,-1,70,9",
                "Text": "{DynamicResource Launch.Account.LoginDialog.Title}",
                "VerticalAlignment": "Top",
                "SnapsToDevicePixels": "False",
                "UseLayoutRounding": "False",
                "MouseLeftButtonDown": "Drag"
              }
            },
            {
              "type": "Rectangle",
              "attrs": {
                "Name": "ShapeLine",
                "Grid.Row": "1",
                "Height": "2",
                "Fill": "{Binding Foreground, ElementName=LabTitle}"
              }
            },
            {
              "type": "PScrollViewer",
              "attrs": {
                "Grid.Row": "3",
                "VerticalAlignment": "Top",
                "Name": "PanCaption",
                "Margin": "0,0,0,17",
                "Padding": "7,0,15,0",
                "VerticalScrollBarVisibility": "Auto",
                "HorizontalScrollBarVisibility": "Disabled",
                "DeltaMult": "0.7"
              },
              "children": [
                {
                  "type": "TextBlock",
                  "attrs": {
                    "VerticalAlignment": "Top",
                    "TextTrimming": "None",
                    "TextWrapping": "Wrap",
                    "Name": "LabCaption",
                    "FontSize": "15",
                    "LineHeight": "18",
                    "Foreground": "{DynamicResource ColorBrush1}",
                    "FontWeight": "Normal",
                    "Padding": "1"
                  }
                }
              ]
            },
            {
              "type": "StackPanel",
              "attrs": {
                "Grid.Row": "4",
                "Name": "PanBtn",
                "VerticalAlignment": "Top",
                "HorizontalAlignment": "Right",
                "Margin": "150,0,8,0",
                "Orientation": "Horizontal"
              },
              "children": [
                {
                  "type": "PButton",
                  "attrs": {
                    "ColorType": "Normal",
                    "FieldModifier": "public",
                    "Text": "{DynamicResource Launch.Account.LoginDialog.ReopenWebpage}",
                    "Name": "Btn1",
                    "Margin": "12,0,0,0",
                    "TextPadding": "7",
                    "SnapsToDevicePixels": "False",
                    "Padding": "5,0",
                    "UseLayoutRounding": "False",
                    "CustomEventService.EventType": "OpenUrl"
                  }
                },
                {
                  "type": "PButton",
                  "attrs": {
                    "ColorType": "Normal",
                    "FieldModifier": "public",
                    "Text": "{DynamicResource Launch.Account.LoginDialog.CopyCode}",
                    "Name": "Btn2",
                    "Margin": "12,0,0,0",
                    "TextPadding": "7",
                    "SnapsToDevicePixels": "False",
                    "Padding": "5,0",
                    "UseLayoutRounding": "False",
                    "CustomEventService.EventType": "CopyText"
                  }
                },
                {
                  "type": "PButton",
                  "attrs": {
                    "ColorType": "Normal",
                    "FieldModifier": "public",
                    "Text": "{DynamicResource Common.Action.Cancel}",
                    "Name": "Btn3",
                    "Margin": "12,0,0,0",
                    "TextPadding": "7",
                    "SnapsToDevicePixels": "False",
                    "Padding": "5,0",
                    "UseLayoutRounding": "False",
                    "Click": "Btn3_Click"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
