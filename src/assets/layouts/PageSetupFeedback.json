                  "type": "StackPanel",
                  "attrs": {
                    "Orientation": "Vertical",
                    "Margin": "20,40,18,22"
                  },
                  "children": [
                    {
                      "type": "TextBlock",
                      "attrs": {
                        "Text": "{DynamicResource Setup.Feedback.Submit.Description}",
                        "TextWrapping": "Wrap"
                      }
                    },
                    {
                      "type": "Grid",
                      "attrs": {
                        "Margin": "0,15,0,0",
