                                "SharedSizeGroup": "Button"
                              }
                            }
                          ]
                        },
                        {
                          "type": "PButton",
                          "attrs": {
                            "Name": "BtnManageOpen",
                            "Grid.Column": "0",
                            "MinWidth": "140",
                            "Text": "{DynamicResource Setup.Feedback.Submit.Open}",
                            "Padding": "13,0",
                            "Margin": "0,0,20,0",
                            "HorizontalAlignment": "Left",
                            "ColorType": "Highlight",
                            "Click": "Feedback_Click"
                          }
                        }
                      ]
