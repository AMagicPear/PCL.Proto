{
  "type": "PPageRight",
  "attrs": {
    "Class": "PCL.PageSetupFeedback",
    "PanScroll": "{Binding ElementName=PanBack}"
  },
  "children": [
    {
      "type": "PScrollViewer",
      "attrs": {
        "VerticalScrollBarVisibility": "Auto",
